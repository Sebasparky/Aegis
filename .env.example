# Aegis / Antigen — local environment template
#
# Copy to `.env` at the REPO ROOT (apps/api/src/index.ts loads ../../../.env). `.env` is
# gitignored. Every value below is a placeholder; none is a working key. Never commit `.env`.
#
# Generate the two signing keys locally (prints two lines; paste them here):
#   node apps/api/scripts/generate-receipt-keypair.mjs
# Generate the local KMS key:
#   openssl rand -base64 32
# Check the result without printing any value:
#   npm run demo:preflight

# ── Required for the /demo guard loop ───────────────────────────────────────────
# Ed25519 JWKs for receipt signing. Approvals FAIL CLOSED without these
# (routes/approvals.ts). AEGIS_RECEIPT_ALLOW_UNSIGNED_DEV does not rescue approvals.
AEGIS_RECEIPT_JWS_PRIVATE_JWK='{"kty":"OKP","crv":"Ed25519","x":"<base64url>","d":"<base64url-REPLACE-ME>"}'
AEGIS_RECEIPT_JWS_PUBLIC_JWK='{"kty":"OKP","crv":"Ed25519","x":"<base64url>"}'

# 32 random bytes, base64. Encrypts seeded demo secrets (AES-256-GCM, local_dev provider).
AEGIS_LOCAL_KMS_KEY_B64=REPLACE_WITH_openssl_rand_-base64_32

# ── Network boundary ────────────────────────────────────────────────────────────
# Internal routes have no network authentication. The API refuses to start on anything
# other than a loopback host. Allowed: 127.0.0.1 (default), ::1, localhost (both families).
AEGIS_API_BIND_HOST=127.0.0.1

# ── Providers (defaults shown; leave as-is for the demo) ───────────────────────
AEGIS_PERSISTENCE_PROVIDER=local          # local (JSON file under apps/api/.data) | supabase
AEGIS_KMS_PROVIDER=local_dev              # local_dev | cloud_kms_stub (always throws)
AEGIS_RECEIPT_ISSUER=aegis-local-dev
# AEGIS_RECEIPT_ALLOW_UNSIGNED_DEV=false  # does NOT bypass approval signing; leave unset

# ── Optional: agent browser runtime (not needed for /demo) ─────────────────────
# AEGIS_PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222   # legacy static CDP target
# ANTIGEN_BROWSER_HEADLESS=false
# ANTIGEN_INPUT_REALISM=realistic
# ANTIGEN_BROWSER_TRACE=true
# ANTIGEN_HUMAN_VERIFICATION=true
# ANTIGEN_VISUAL_GESTURE_CAPSULE=true

# ── Optional: external services (never required locally; all placeholders) ────
# AEGIS_PERSISTENCE_PROVIDER=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<placeholder-never-commit>
# EMAIL_DELIVERY_PROVIDER=dev_console     # dev_console logs the OTP locally; resend sends real mail
# RESEND_API_KEY=<placeholder>
# EMAIL_FROM=verify@example.test
# STRIPE_IDENTITY_ENABLED=false           # Stripe is used for Identity verification only, never payments
# STRIPE_SECRET_KEY=sk_test_<placeholder>
# STRIPE_IDENTITY_RETURN_URL=http://localhost:3000/verify
# SHEERID_ENABLED=false
# SHEERID_API_TOKEN=<placeholder>
# GOOGLE_CLIENT_ID=<placeholder>
# GOOGLE_CLIENT_SECRET=<placeholder>
# GOOGLE_REFRESH_TOKEN=<placeholder>
# AEGIS_EXTENSION_SECRET=<placeholder>    # Chrome recorder extension ↔ API shared secret

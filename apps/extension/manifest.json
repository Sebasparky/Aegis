{
  "manifest_version": 3,
  "name": "Aegis Recorder",
  "version": "0.1.0",
  "description": "Record workflows on external websites for Aegis Rails.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:4000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aegis Recorder"
  }
}
